{
  "services": {
    "monitor": {
      "network_mode": "host",
      "ipc": "private",
      "shm_size": 1,
      "ulimits": {
        "nofile": 8192
      },
      "environment": {
        "CUSTOM": "kept"
      },
      "image": "app:test"
    },
    "adopted": {
      "networks": {
        "users": {}
      },
      "environment": {
        "DORA_NODE_ID": "app-chosen",
        "DORA_DAEMON_LOCAL_LISTEN_PORT": "wrong",
        "DORA_ZENOH_CONFIG_OVERLAY": "wrong"
      },
      "volumes": [
        {
          "type": "volume",
          "source": "data",
          "target": "/data"
        }
      ],
      "image": "app:test"
    }
  },
  "networks": {
    "users": {}
  },
  "volumes": {
    "data": {}
  }
}
