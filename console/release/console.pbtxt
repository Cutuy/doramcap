# Release template: system app manifests are relative to system-apps, project paths to the playground.
# The release workflow replaces each :local image with its multi-arch digest.
form: COMPOSE
dora_apps: "dora-coordinator"
dora_apps: "dora-daemon"
apps { manifest: "dora-coordinator/dora-coordinator.pbtxt" }
apps { manifest: "dora-daemon/dora-daemon.pbtxt" }
runtime { readiness_seconds: 60 stop_seconds: 30 sample_interval_ms: 100 }
apps {
  manifest: "live-bridge/live-bridge.pbtxt"
  default_selected: true
  live_relay {}
}
apps {
  manifest: "cpu-monitor/cpu-monitor.pbtxt"
  default_selected: true
  live_outputs { source: "cpu-monitor/snapshots" kind: CPU_ACCOUNTING }
  live_outputs { source: "cpu-monitor/dictionary" kind: CPU_ACCOUNTING }
}
apps {
  manifest: "data-recorder/data-recorder.pbtxt"
}
apps {
  manifest: "fault-watchdog/fault-watchdog.pbtxt"
  health_inputs: true
  live_outputs { source: "fault-watchdog/faults" kind: FAULT_PUBLICATION }
}
