id: "data-recorder"
label: "Data recorder"
graph: "flow.yml"
config_target: "/config/recorder.pbtxt"
output_targets: "/results"
compose { files: "compose.yaml" service: "data-recorder" }
systemd {
  unit: "data-recorder.service"
  files { source: "telemetry_descriptor.bin" target: "/config/telemetry_descriptor.bin" }
}
variants {
  id: "cpu"
  label: "CPU topics (requires CPU monitoring)"
  config: "recorder.pbtxt"
  recordings { id: "messages" path: "messages.mcap" }
}
variants {
  id: "faults"
  label: "Watchdog publications (requires watchdog)"
  config: "faults.pbtxt"
  graph: "faults.yml"
  recordings { id: "messages" path: "messages.mcap" }
}
