id: "data-recorder"
label: "Data recorder"
graph: "flow.yml"
compose {
  files: "compose.yaml"
  config_mount { service: "data-recorder" target: "/config/recorder.pbtxt" }
  output_mounts { service: "data-recorder" target: "/results" }
}
variants {
  id: "cpu"
  label: "CPU topics (requires CPU monitoring)"
  config: "recorder.pbtxt"
  recordings { id: "messages" path: "messages.mcap" }
}
variants {
  id: "faults"
  label: "Watchdog publications (requires watchdog)"
  config: "faults.pbtxt"
  graph: "faults.yml"
  recordings { id: "messages" path: "messages.mcap" }
}
program {
  executable: "mcap-recorder"
  args: "--config" args: "/config/recorder.pbtxt"
  memlock_bytes: 268435456
  kill_signal: 2
  config_target: "/config/recorder.pbtxt"
  output_targets: "/results"
  files { source: "telemetry_descriptor.bin" target: "/config/telemetry_descriptor.bin" }
}
