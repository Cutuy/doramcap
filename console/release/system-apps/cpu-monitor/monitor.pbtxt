include: "live.pbtxt"
app {
  id: "monitor"
  config { [type.googleapis.com/doramcap.monitor.v1.MonitorConfig] {
    output_path: "/results/cpu.pb"
    recording {
      path: "/results/cpu.mcap"
      samples_topic: "doramcap/cpuacct"
      dictionary_topic: "doramcap/cpuacct/dictionary"
    }
  } }
}
