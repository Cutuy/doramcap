id: "cpu-monitor"
label: "CPU monitoring"
graph: "flow.yml"
config_target: "/config/monitor.pbtxt"
output_targets: "/results"
compose { files: "compose.yaml" service: "cpu-monitor" }
systemd {
  unit: "cpu-monitor.service"
}
variants {
  id: "record"
  label: "Live panels and recording"
  config: "monitor.pbtxt"
  recordings { id: "cpu" path: "cpu.mcap" stream: "cpu.pb" cpu: true }
}
variants { id: "live" label: "Live panels only" config: "live.pbtxt" }
