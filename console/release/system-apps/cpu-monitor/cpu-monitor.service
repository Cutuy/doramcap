# Native systemd launch of CPU monitoring. Doramcap adopts this file unchanged and adds
# the run's slice, private root, binds and binaries search path in a runtime drop-in.
[Unit]
Description=Doramcap CPU monitoring

[Service]
ExecStart=system-monitor --config /config/monitor.pbtxt
LimitMEMLOCK=268435456
KillSignal=SIGINT
TimeoutStopSec=15
