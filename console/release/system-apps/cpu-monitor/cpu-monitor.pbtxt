id: "cpu-monitor"
label: "CPU monitoring"
graph: "flow.yml"
config_target: "/config/monitor.pbtxt"
output_targets: "/results"
compose { files: "compose.yaml" service: "cpu-monitor" }
variants {
  id: "record"
  label: "Live panels and recording"
  config: "cpu-monitor-record.pbtxt"
  recordings { id: "cpu" path: "cpu.mcap" stream: "cpu.pb" cpu: true }
}
variants { id: "live" label: "Live panels only" config: "cpu-monitor-live.pbtxt" }
process {
  argv: "system-monitor"
  argv: "--config"
  argv: "/config/monitor.pbtxt"
  memlock_bytes: 268435456
  stop_signal: 2
  stop_seconds: 15
}
