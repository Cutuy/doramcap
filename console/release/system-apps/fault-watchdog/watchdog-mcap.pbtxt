source_timeout_ms: 3000
snapshot_interval_ms: 500
maintenance_ms: 10
queue_capacity: 32
shutdown_ms: 5000
live_output: "faults"
mcap {
  enabled: true
  path: "/results/faults.mcap"
  rotation_bytes: 0
  flush_ms: 100
}
max_sources: 16
max_conditions_per_source: 32
max_batch_records: 512
output_capacity: 1024
dedup_window: 128
transport_allowance_ms: 0
max_frame_bytes: 2097152
retry_count: 2
retry_delay_ms: 100
