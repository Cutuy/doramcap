# Relays selected apps' live outputs; Console generates its node and bridge config.
id: "live-bridge"
label: "Live telemetry"
compose {
  files: "compose.yaml"
  config_mount { service: "live-bridge" target: "/config/bridge.pbtxt" }
}
program {
  executable: "live-bridge"
  args: "--config" args: "/config/bridge.pbtxt"
  kill_signal: 2
  config_target: "/config/bridge.pbtxt"
}
