# Relays selected apps' live outputs; Console generates its node and bridge config.
id: "live-bridge"
label: "Live telemetry"
config_target: "/config/bridge.pbtxt"
compose { files: "compose.yaml" service: "live-bridge" }
process {
  argv: "live-bridge"
  argv: "--config"
  argv: "/config/bridge.pbtxt"
  stop_signal: 2
  stop_seconds: 15
}
