# Records a user node's messages: Console merges dora.yml with the chosen profile's flow.yml.
# dataflow_file is relative to this directory; app paths are relative to console/.
dataflow_file: "dora.yml"
dora_apps: "dora-coordinator"
dora_apps: "dora-daemon"
apps { id: "dora-coordinator" input { directory: "release/system-apps/dora-coordinator" files: "compose.yaml" } }
apps { id: "dora-daemon" input { directory: "release/system-apps/dora-daemon" files: "compose.yaml" } }
apps {
  id: "data-recorder"
  label: "Data recorder"
  input { directory: "release/system-apps/data-recorder" files: "compose.yaml" }
  output_mounts { service: "data-recorder" target: "/results" }
  config_mount { service: "data-recorder" target: "/config/recorder.pbtxt" }
  launch_profiles {
    id: "user-messages"
    label: "User messages"
    config: "examples/user-messages/recorder.pbtxt"
    graph: "examples/user-messages/flow.yml"
    recordings { id: "messages" path: "messages.mcap" }
  }
}
