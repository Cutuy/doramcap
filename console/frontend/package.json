    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "protobufjs-cli": "^2.7.1",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
