    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "const": "compile"
        },
        "result": {
          "$ref": "#/$defs/RuleCompileResult"
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "stage",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "const": "screen"
        },
        "result": {
          "$ref": "#/$defs/ScreenDecision"
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "stage",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "const": "confirm"
        },
        "result": {
          "$ref": "#/$defs/ConfirmDecision"
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "stage",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "const": "fix"
        },
        "result": {
          "$ref": "#/$defs/PatchProposal"
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "stage",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
