            "source",
            "contract",
            "test_result",
            "history",
            "tool_result"
          ]
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_hash": {
          "type": "string",
          "minLength": 1
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceSpan"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "artifact_id",
        "artifact_hash",
        "spans",
        "summary"
