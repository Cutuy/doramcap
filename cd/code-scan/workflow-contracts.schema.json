    "ContextRequest": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "symbol",
            "callers",
            "callees",
            "owner",
            "lifecycle",
            "contract",
            "tests",
            "history"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
