{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rule-by-unit review: proposed harness contracts",
  "description": "Root validates model responses. Referenced definitions also specify code-owned inputs, evidence and validation records. The harness chooses the stage-specific branch for each model call.",
