          "minLength": 1
        },
        "instruction_scope_hash": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "$ref": "#/$defs/RuleSpec"
        },
        "unit": {
          "$ref": "#/$defs/CodeUnit"
        },
        "context": {
