            "type": "string",
            "minLength": 1
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_context": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "local_code",
              "callers",
              "callees",
              "ownership",
              "lifecycle",
              "contracts",
              "tests",
              "history"
            ]
          }
        }
      },
      "required": [
        "rule_id",
        "clause_id",
        "source",
        "rule_hash",
        "obligation",
        "force",
        "applies_when",
        "exceptions",
