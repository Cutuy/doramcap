{
  "rules": [
    {"from": "orchestrator", "forbid": ["workload-*", "bollard", "monitor-core", "task-accounting", "telemetry-protocol"]},
    {"from": "workflow-protocol", "forbid": ["monitor-core", "task-accounting", "telemetry-protocol", "orchestrator", "workload-*"]},
    {"from": "telemetry-protocol", "forbid": ["cpu-viewer", "workflow-protocol"]},
    {"from": "workload-lifecycle", "forbid": ["workload-docker", "workload-supervisor", "bollard"]},
    {"from": "workload-supervisor", "forbid": ["workload-docker", "bollard"]}
  ]
}
