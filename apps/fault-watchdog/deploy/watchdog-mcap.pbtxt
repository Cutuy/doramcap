app {
  id: "watchdog"
  config { [type.googleapis.com/doramcap.watchdog.v1.WatchdogConfig] {
    inputs: "source_a"
    inputs: "source_b"
    source_timeout_ms: 3000
    snapshot_interval_ms: 500
    maintenance_ms: 10
    shutdown_ms: 5000
    mcap { enabled: true path: "/results/faults.mcap" rotation_bytes: 16777216 flush_ms: 100 }
  } }
}
