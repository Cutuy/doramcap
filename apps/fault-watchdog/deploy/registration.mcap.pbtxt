id: "fault-watchdog"
compose_file: "compose.mcap.yaml"
service: "dashboard"
network: "host"
port: 8088
readiness_seconds: 90
stop_seconds: 50
result_file: "state.json"
result_format: FILE
artifact_collections {
  id: "recordings"
  base_file: "faults.mcap"
  prefix: "faults.mcap."
  suffix: ""
  digits: 6
  max_files: 512
  required: true
}
env_prefix: "FAULT_WATCHDOG"
requires_explicit_enable: true
dora { graph: "flow.yml" shm_bytes: 134217728 memlock_bytes: 268435456 }
