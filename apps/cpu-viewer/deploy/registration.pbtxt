id: "cpu-viewer"
compose_file: "compose.yaml"
service: "viewer"
network: "host"
port: 8080
readiness_seconds: 90
stop_seconds: 50
result_file: "cpu.mcap"
recording_count {
  count_file: "published.count"
  topic: "doramcap/cpuacct"
}
env_prefix: "CPU_VIEWER"
requires_explicit_enable: true
dataflow_file: "flow.yml"
dora_apps: "dora-coordinator"
apps { key: "dora-coordinator" directory: "." files: "../../../libs/workload-docker/deploy/dora-coordinator/compose.yaml" files: "dora-coordinator.identity.yaml" }
dora_apps: "dora-daemon"
apps { key: "dora-daemon" directory: "." files: "../../../libs/workload-docker/deploy/dora-daemon/compose.yaml" files: "dora-daemon.identity.yaml" }
mcap_services: "monitor"
