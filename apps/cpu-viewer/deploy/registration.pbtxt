id: "cpu-viewer"
compose_file: "compose.yaml"
service: "viewer"
network: "host"
port: 8080
readiness_seconds: 90
stop_seconds: 50
result_file: "cpu.mcap"
recording_count {
  count_file: "published.count"
  topic: "doramcap/snapshots"
}
env_prefix: "CPU_VIEWER"
requires_explicit_enable: true
dora { graph: "flow.yml" shm_bytes: 134217728 memlock_bytes: 268435456 }
