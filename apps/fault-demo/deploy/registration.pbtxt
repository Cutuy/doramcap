id: "fault-demo"
compose_file: "compose.yaml"
service: "dashboard"
network: "host"
port: 8088
readiness_seconds: 90
stop_seconds: 50
result_file: "state.json"
result_format: FILE
env_prefix: "FAULT_DEMO"
requires_explicit_enable: true
dataflow_file: "flow.yml"
dora_apps: "dora-coordinator"
apps { key: "dora-coordinator" directory: "." files: "../../../libs/workload-docker/deploy/dora-coordinator/compose.yaml" manifest: "../../../libs/workload-docker/deploy/dora-coordinator/dora-coordinator.pbtxt" files: "dora-coordinator.identity.yaml" }
dora_apps: "dora-daemon"
apps { key: "dora-daemon" directory: "." files: "../../../libs/workload-docker/deploy/dora-daemon/compose.yaml" manifest: "../../../libs/workload-docker/deploy/dora-daemon/dora-daemon.pbtxt" files: "dora-daemon.identity.yaml" }
apps { key: "doramcap-shm" directory: "." files: "../../../libs/workload-docker/deploy/shm/compose.yaml" manifest: "../../../libs/workload-docker/deploy/shm/shm.pbtxt" }
