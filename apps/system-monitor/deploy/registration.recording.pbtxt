id: "system-monitor"
compose_file: "compose.recording.yaml"
service: "monitor"
network: "default"
headless: true
readiness_seconds: 60
stop_seconds: 30
result_file: "monitor.pb"
result_format: FILE
artifact_collections {
  id: "recordings"
  base_file: "capture.mcap"
  prefix: "capture."
  suffix: ".mcap"
  digits: 6
  max_files: 512
  required: true
}
shutdown_marker: "shutdown.complete"
env_prefix: "SYSTEM_MONITOR"
seccomp_file: "seccomp.json"
requires_explicit_enable: true
