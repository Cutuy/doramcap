id: "storage-demo"
compose_file: "compose.yaml"
service: "storage"
network: "default"
port: 8091
readiness_seconds: 60
stop_seconds: 30
result_file: "activity.mcap"
capture_directory: "captures"
env_prefix: "STORAGE"
requires_explicit_enable: true
mcap_services: "storage"
apps { key: "doramcap-shm" directory: "." files: "../../../libs/workload-docker/deploy/shm/compose.yaml" manifest: "../../../libs/workload-docker/deploy/shm/shm.pbtxt" }
