[Unit]
Description=Doramcap gallery loopback proxy
Requires=docker.service
After=docker.service doramcap-gallery.service

[Service]
ExecStartPre=-/usr/bin/docker rm -f doramcap-gallery-caddy
ExecStart=/usr/bin/docker run --rm --pull never --name doramcap-gallery-caddy --network host --read-only --cap-drop ALL --security-opt no-new-privileges --memory 64m --pids-limit 128 --log-opt max-size=10m --log-opt max-file=3 --tmpfs /config --tmpfs /data -v /opt/doramcap-gallery/current/caddy:/etc/caddy:ro caddy:2 caddy run --config /etc/caddy/Caddyfile
ExecStop=/usr/bin/docker stop --time 10 doramcap-gallery-caddy
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
