id: "orchestrator-demo"
compose_file: "compose.yaml"
service: "server"
network: "default"
port: 8080
readiness_seconds: 90
stop_seconds: 110
result_file: "summary.json"
result_optional: true
result_format: FILE
artifact_collections {
  id: "cpu-recordings"
  base_file: "cpu.mcap"
  prefix: "cpu."
  suffix: ".mcap"
  digits: 6
  max_files: 512
  directory: "runs"
  run_directories: true
  generation_runs: true
}
shutdown_marker: "shutdown.complete"
private_directories: "socket"
private_directories: "recovery"
docker_socket: true
nested_runs: true
nested_projects {
  key: "demo"
  remove_volumes: true
}
nested_projects {
  key: "system"
  remove_volumes: false
}
env_prefix: "ORCHESTRATOR"
requires_explicit_enable: true
