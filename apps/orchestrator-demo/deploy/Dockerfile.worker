FROM docker:27-cli AS docker_cli
FROM node:22-bookworm-slim AS node_runtime
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker_cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node
COPY orchestrator-worker /usr/local/bin/orchestrator-worker
COPY seccomp.json /opt/orchestrator/seccomp.json
COPY worker-host.ts /opt/orchestrator/worker-host.ts
ENV HOME=/tmp
WORKDIR /tmp
ENTRYPOINT ["node", "--experimental-strip-types", "/opt/orchestrator/worker-host.ts"]
