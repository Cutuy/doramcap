id: "activity-demo"
compose_file: "compose.yaml"
service: "activity"
network: "default"
port: 8088
readiness_seconds: 60
stop_seconds: 30
result_file: "activity.mcap"
env_prefix: "ACTIVITY"
requires_explicit_enable: false
mcap_services: "activity"
apps { key: "doramcap-shm" directory: "." files: "../../../libs/workload-docker/deploy/shm/compose.yaml" manifest: "../../../libs/workload-docker/deploy/shm/shm.pbtxt" }
